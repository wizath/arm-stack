class Colors:
    """ANSI color codes for enhanced terminal output"""
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    END = '\033[0m'


# Tool configuration constants
DEFAULT_OBJDUMP = "arm-none-eabi-objdump"
CALL_COST = 4  # ARM function call overhead in bytes
DEFAULT_STACK_MARGIN = 1.5  # Safety margin for thread stack recommendations
SUBPROCESS_TIMEOUT = 60  # Timeout for subprocess calls in seconds
MAX_UNRESOLVED_DISPLAY = 20  # Maximum unresolved functions to display
MAX_FUNCTION_NAME_LEN = 39  # Maximum function name length before truncation

# RTOS thread/task creation patterns for auto-detection
# Format: (function_pattern, entry_func_arg_position, stack_size_arg_position)
RTOS_THREAD_PATTERNS = {
    'FreeRTOS': [
        (r'xTaskCreate\s*\(\s*(\w+)', 0, None),
        (r'xTaskCreateStatic\s*\(\s*(\w+)', 0, None),
    ],
    'Zephyr': [
        (r'k_thread_create\s*\([^,]+,\s*[^,]+,\s*[^,]+,\s*(\w+)', 0, None),
        (r'K_THREAD_DEFINE\s*\(\s*\w+\s*,\s*\d+\s*,\s*(\w+)', 0, None),
    ],
    'CMSIS-RTOS': [
        (r'osThreadNew\s*\(\s*(\w+)', 0, None),
        (r'osThreadCreate\s*\([^,]+,\s*(\w+)', 0, None),
    ],
    'ThreadX': [
        (r'tx_thread_create\s*\([^,]+,\s*[^,]+,\s*(\w+)', 0, None),
    ],
    'Azure-RTOS': [
        (r'tx_thread_create\s*\([^,]+,\s*[^,]+,\s*(\w+)', 0, None),
    ],
    'embOS': [
        (r'OS_TASK_Create\s*\([^,]+,\s*[^,]+,\s*(\w+)', 0, None),
        (r'OS_TASK_CreateEx\s*\([^,]+,\s*[^,]+,\s*(\w+)', 0, None),
    ],
    'uC/OS': [
        (r'OSTaskCreate\s*\(\s*(\w+)', 0, None),
        (r'OSTaskCreateExt\s*\(\s*(\w+)', 0, None),
    ],
    'POSIX': [
        (r'pthread_create\s*\([^,]+,\s*[^,]+,\s*(\w+)', 0, None),
    ],
}

# Data structure for function information
FunctionInfo = namedtuple('FunctionInfo', [
    'name',              # Function name (cleaned)
    'cost',              # Total stack cost including callees
    'frame_size',        # Local frame size from .su file
    'height',            # Call chain depth
    'is_recursive',      # Whether function is recursive
    'is_root',           # Whether function is a root (entry point)
    'is_unbounded',      # Whether function has unbounded stack usage
    'unbounded_reason',  # Reason for unbounded stack (recursion, function_pointer, etc.)
    'code_size',         # Function code size in flash (bytes)
    'data_size',         # Initialized data (.data) per source file
    'bss_size',          # Uninitialized data (.bss) per source file
    'has_heap_alloc'     # Whether function calls malloc/free etc.
])

# Heap allocation function patterns to detect
HEAP_ALLOC_FUNCTIONS = {
    'malloc', 'free', 'calloc', 'realloc',  # Standard C
    'pvPortMalloc', 'vPortFree',             # FreeRTOS
    'k_malloc', 'k_free',                    # Zephyr
    'mem_malloc', 'mem_free',                # lwIP
    'OS_MemGet', 'OS_MemPut',                # uC/OS
}

# Data structure for detected thread/task information
ThreadInfo = namedtuple('ThreadInfo', [
    'entry_func',        # Thread entry function name
    'rtos',              # Detected RTOS type
    'source_file',       # Source file where thread was created
    'stack_usage',       # Calculated stack usage
    'recommended',       # Recommended stack size (with margin)
    'is_unbounded'       # Whether stack usage is unbounded
])


class AnalysisData:
    """Shared data container for analysis results between components."""

    def __init__(self):
        # Core data structures for analysis
        self.frame_size: Dict[str, int] = {}
        self.call_graph: Dict[str, Set[str]] = defaultdict(set)
        self.total_cost: Dict[str, int] = {}
        self.call_depth: Dict[str, int] = {}
        self.visited: Dict[str, str] = {}
        self.has_caller: Set[str] = set()
        self.unresolved: Set[str] = set()

        # Symbol resolution tables
        self.addresses: Dict[int, str] = {}
        self.global_name: Dict[str, str] = {}
        self.ambiguous: Set[str] = set()

        # Function pointer detection
        self.has_function_pointer: Set[str] = set()
        self.rtl_available: bool = False

        # Code size tracking (flash usage)
        self.code_size: Dict[str, int] = {}
        self.elf_code_size: Dict[str, int] = {}
        self.elf_file: Optional[str] = None

        # Static allocation tracking (RAM usage)
        self.data_size: Dict[str, int] = {}
        self.bss_size: Dict[str, int] = {}
        self.static_size: Dict[str, int] = {}
        self.elf_data_size: Dict[str, int] = {}
        self.elf_bss_size: Dict[str, int] = {}
        self.func_static_vars: Dict[str, List[tuple]] = {}

        # Memory region tracking (symbol -> section name)
        self.symbol_sections: Dict[str, str] = {}  # symbol -> section name
        self.section_sizes: Dict[str, int] = {}    # section -> total size
        self.memory_regions: Dict[str, Dict] = {}  # region -> {start, size, used}

        # Heap allocation detection
        self.has_heap_alloc: Set[str] = set()

        # Git repository information
        self.git_info: Dict[str, str] = {}

        # Thread/task detection
        self.detected_threads: List[ThreadInfo] = []


class ObjectFileParser:
    """Handles parsing of object files, .su files, and ELF binaries."""

    def __init__(self, build_dir: Path, objdump_path: str, data: AnalysisData):
        self.build_dir = build_dir
        self.objdump_path = objdump_path
        self.data = data
        self.logger = logging.getLogger(__name__)

    def find_object_files(self) -> List[str]:
        """Locate all relevant object files in the build directory."""
        patterns = ["**/*.o", "**/*.c.obj"]
        obj_files = []

        for pattern in patterns:
            obj_files.extend(glob.glob(str(self.build_dir / pattern), recursive=True))

        filtered = [
            f for f in obj_files
            if "CMakeFiles/CompilerIdC" not in f
            and "CMakeFiles/CompilerIdCXX" not in f
        ]

        self.logger.info(f"  Found {len(filtered)} object files")
        return sorted(filtered)

    def parse_disassembly(self, obj_file: str) -> None:
        """Parse object file disassembly to extract call graph."""
        try:
            result = subprocess.run(
                [self.objdump_path, "-dr", obj_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            current_function = None

            for line in result.stdout.splitlines():
                line = line.strip()

                func_match = re.match(r'^([0-9a-fA-F]+) <(.*)>:', line)
                if func_match:
                    addr, name = func_match.groups()
                    current_function = f"{name}@{obj_file}"
                    self.data.call_graph[current_function] = set()

                    if name in self.data.global_name:
                        self.data.ambiguous.add(name)
                    self.data.global_name[name] = current_function

                    addr = addr.lstrip('0') or '0'
                    self.data.addresses[f"{addr}@{obj_file}"] = current_function

                call_match = re.search(r': R_[A-Za-z0-9_]+_CALL\s+(.+)', line)
                if call_match and current_function:
                    target = call_match.group(1)

                    if target in HEAP_ALLOC_FUNCTIONS:
                        self.data.has_heap_alloc.add(current_function)

                    if target == ".text":
                        target = f"@{obj_file}"
                    elif target.startswith(".text+0x"):
                        offset = target[9:]
                        target = f"{offset}@{obj_file}"

                    self.data.call_graph[current_function].add(target)

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
            print(f"{Colors.RED}Error disassembling {obj_file}: {e}{Colors.END}")
            sys.exit(1)

    def parse_su_file(self, obj_file: str) -> None:
        """Parse stack usage file to extract frame sizes."""
        if obj_file.endswith('.o'):
            su_file = obj_file[:-2] + '.su'
        elif obj_file.endswith('.c.obj'):
            su_file = obj_file[:-6] + '.c.su'
        else:
            return

        try:
            with open(su_file, 'r') as f:
                for line in f:
                    match = re.match(r'.*:(\w+)\s+(\d+)\s+(\w+)', line)
                    if match:
                        func_name, size, qualifier = match.groups()
                        func_full_name = f"{func_name}@{obj_file}"
                        self.data.frame_size[func_full_name] = int(size) + CALL_COST
        except FileNotFoundError:
            pass

    def parse_static_sizes(self, obj_file: str) -> None:
        """Parse object file to extract .data and .bss sizes."""
        nm_path = self.objdump_path.replace('objdump', 'nm')

        try:
            result = subprocess.run(
                [nm_path, '--print-size', obj_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            total_data = 0
            total_bss = 0

            for line in result.stdout.splitlines():
                parts = line.strip().split()
                if len(parts) >= 4:
                    size_hex, sym_type, sym_name = parts[1], parts[2], parts[3]
                    try:
                        size = int(size_hex, 16)
                    except ValueError:
                        continue

                    if sym_type in ('D', 'd'):
                        total_data += size
                        var_type = 'data'
                    elif sym_type in ('B', 'b'):
                        total_bss += size
                        var_type = 'bss'
                    else:
                        continue

                    if '.' in sym_name:
                        func_name = sym_name.split('.')[0]
                        var_name = sym_name.split('.', 1)[1]
                        if func_name not in self.data.func_static_vars:
                            self.data.func_static_vars[func_name] = []
                        self.data.func_static_vars[func_name].append((var_name, size, var_type))

            if total_data > 0:
                self.data.data_size[obj_file] = total_data
            if total_bss > 0:
                self.data.bss_size[obj_file] = total_bss
            if total_data + total_bss > 0:
                self.data.static_size[obj_file] = total_data + total_bss

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
            pass

    def parse_elf(self, elf_file: str) -> None:
        """Parse ELF file for accurate linked sizes."""
        self.data.elf_file = elf_file
        nm_path = self.objdump_path.replace('objdump', 'nm')

        self.logger.info(f"Parsing ELF file: {elf_file}")

        try:
            result = subprocess.run(
                [nm_path, '--print-size', elf_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            for line in result.stdout.splitlines():
                parts = line.strip().split()
                if len(parts) >= 4:
                    size_hex, sym_type, name = parts[1], parts[2], parts[3]
                    try:
                        size = int(size_hex, 16)
                    except ValueError:
                        continue

                    if sym_type in ('T', 't'):
                        self.data.elf_code_size[name] = size
                    elif sym_type in ('D', 'd'):
                        self.data.elf_data_size[name] = size
                    elif sym_type in ('B', 'b'):
                        self.data.elf_bss_size[name] = size

            self.logger.info(f"  Code: {len(self.data.elf_code_size)} functions")
            self.logger.info(f"  .data: {len(self.data.elf_data_size)} symbols")
            self.logger.info(f"  .bss: {len(self.data.elf_bss_size)} symbols")

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError) as e:
            self.logger.warning(f"Failed to parse ELF: {e}")

        # Also parse sections for memory region detection
        self._parse_elf_sections(elf_file)

    def _parse_elf_sections(self, elf_file: str) -> None:
        """Parse ELF sections to detect memory regions (SRAM vs HyperRAM etc)."""
        try:
            # Use objdump -h to get section headers
            result = subprocess.run(
                [self.objdump_path, '-h', elf_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            for line in result.stdout.splitlines():
                # Format: "idx name size vma lma file_off algn flags"
                # Example: "  3 .data 00001234 20000000 08010000 00010000 2**2"
                parts = line.split()
                if len(parts) >= 6 and parts[0].isdigit():
                    section_name = parts[1]
                    try:
                        size = int(parts[2], 16)
                        vma = int(parts[3], 16)
                    except ValueError:
                        continue

                    if size > 0:
                        self.data.section_sizes[section_name] = size
                        # Detect memory region by VMA address or section name
                        region = self._classify_memory_region(section_name, vma)
                        if region not in self.data.memory_regions:
                            self.data.memory_regions[region] = {'size': 0, 'sections': []}
                        self.data.memory_regions[region]['size'] += size
                        self.data.memory_regions[region]['sections'].append(section_name)

            # Now get symbol-to-section mapping using nm -S
            nm_path = self.objdump_path.replace('objdump', 'nm')
            result = subprocess.run(
                [nm_path, '-S', '--format=sysv', elf_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            for line in result.stdout.splitlines():
                # SysV format: "name |address |class|type|size|line|section"
                if '|' in line:
                    parts = [p.strip() for p in line.split('|')]
                    if len(parts) >= 7:
                        name, section = parts[0], parts[6]
                        if name and section and section != '':
                            self.data.symbol_sections[name] = section

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
            pass

    def _classify_memory_region(self, section_name: str, vma: int) -> str:
        """Classify section into memory region based on name or address."""
        section_lower = section_name.lower()

        # Check section name patterns for external RAM
        external_patterns = ['hyperram', 'sdram', 'extram', 'qspi', 'ospi', 'psram']
        for pattern in external_patterns:
            if pattern in section_lower:
                return 'EXTERNAL_RAM'

        # Check section name patterns for special internal regions
        if 'ccm' in section_lower or 'ccmram' in section_lower:
            return 'CCM_RAM'
        if 'dtcm' in section_lower:
            return 'DTCM'
        if 'itcm' in section_lower:
            return 'ITCM'
        if 'backup' in section_lower or 'bkp' in section_lower:
            return 'BACKUP_RAM'

        # Default RAM sections
        if section_name in ('.data', '.bss', '.noinit'):
            return 'INTERNAL_SRAM'

        # Check VMA for common STM32 memory regions (customize as needed)
        # These are typical ranges, may vary by MCU
        if 0x20000000 <= vma < 0x20100000:
            return 'INTERNAL_SRAM'
        if 0x10000000 <= vma < 0x10010000:
            return 'CCM_RAM'
        if 0x90000000 <= vma < 0xA0000000:
            return 'EXTERNAL_RAM'  # Common HyperRAM/QSPI range

        # Flash sections
        if section_name in ('.text', '.rodata'):
            return 'FLASH'
        if 0x08000000 <= vma < 0x08200000:
            return 'FLASH'

        return 'OTHER'

    def parse_map_file(self, map_file: str) -> None:
        """Parse linker map file for detailed memory region info."""
        self.logger.info(f"Parsing map file: {map_file}")

        try:
            with open(map_file, 'r') as f:
                content = f.read()

            # Parse memory configuration section
            in_memory_config = False
            for line in content.splitlines():
                if 'Memory Configuration' in line:
                    in_memory_config = True
                    continue
                if in_memory_config:
                    if line.strip() == '' or 'Linker script' in line:
                        in_memory_config = False
                        continue
                    # Format: "NAME ORIGIN LENGTH ATTRIBUTES"
                    parts = line.split()
                    if len(parts) >= 3 and parts[0] not in ('Name', '*default*'):
                        name = parts[0]
                        try:
                            origin = int(parts[1], 16) if parts[1].startswith('0x') else int(parts[1])
                            length = int(parts[2], 16) if parts[2].startswith('0x') else int(parts[2])
                            self.data.memory_regions[name] = {
                                'origin': origin,
                                'length': length,
                                'size': 0,
                                'sections': []
                            }
                        except ValueError:
                            pass

            self.logger.info(f"  Found {len(self.data.memory_regions)} memory regions")

        except FileNotFoundError:
            self.logger.warning(f"Map file not found: {map_file}")
        except Exception as e:
            self.logger.warning(f"Failed to parse map file: {e}")


class CallGraphAnalyzer:
    """Handles call graph analysis and stack cost calculation."""

    def __init__(self, data: AnalysisData, show_warnings: bool = True):
        self.data = data
        self.show_warnings = show_warnings
        self.logger = logging.getLogger(__name__)

    def resolve_symbols(self) -> None:
        """Resolve function references across object files."""
        for func_name, callees in list(self.data.call_graph.items()):
            resolved_callees = set()

            for callee in callees:
                if callee.startswith('@'):
                    resolved_callees.add(callee)
                elif '@' in callee:
                    addr_key = callee
                    if addr_key in self.data.addresses:
                        resolved_callees.add(self.data.addresses[addr_key])
                    else:
                        self.data.unresolved.add(callee)
                elif callee in self.data.global_name:
                    resolved_callees.add(self.data.global_name[callee])
                else:
                    self.data.unresolved.add(callee)

            self.data.call_graph[func_name] = resolved_callees

    def trace_call_graph(self) -> None:
        """Calculate stack costs through DFS traversal."""
        self.logger.info("Analyzing call graph...")

        def trace(func_name: str) -> None:
            if func_name in self.data.visited:
                if self.data.visited[func_name] == "?":
                    self.data.visited[func_name] = "R"
                    self.data.total_cost[func_name] = float('inf')
                    self.data.call_depth[func_name] = float('inf')
                return

            self.data.visited[func_name] = "?"

            if func_name in self.data.has_function_pointer:
                self.data.visited[func_name] = "P"
                self.data.total_cost[func_name] = float('inf')
                self.data.call_depth[func_name] = float('inf')
                return

            max_depth = 0
            max_frame = 0

            if func_name in self.data.call_graph:
                for callee in self.data.call_graph[func_name]:
                    self.data.has_caller.add(callee)
                    trace(callee)

                    callee_cost = self.data.total_cost.get(callee, 0)
                    callee_depth = self.data.call_depth.get(callee, 0)

                    if callee_cost == float('inf') or callee_depth == float('inf'):
                        self.data.visited[func_name] = "U"
                        self.data.total_cost[func_name] = float('inf')
                        self.data.call_depth[func_name] = float('inf')
                        return

                    max_frame = max(max_frame, callee_cost)
                    max_depth = max(max_depth, callee_depth)

            self.data.call_depth[func_name] = max_depth + 1
            self.data.total_cost[func_name] = max_frame + self.data.frame_size.get(func_name, 0)

            if self.data.visited[func_name] == "?":
                self.data.visited[func_name] = " "

        for func_name in self.data.call_graph:
            trace(func_name)


class StackAnalyzer:
    """
    Main orchestrator for ARM stack usage analysis.

    Coordinates the parsing, analysis, and reporting components:
    - ObjectFileParser: Parses object files, .su files, and ELF binaries
    - CallGraphAnalyzer: Resolves symbols and calculates stack costs
    - Report generation methods for various output formats
    """

    def __init__(
            self,
            build_dir: str,
            threshold: int = 10,
            show_warnings: bool = True,
            objdump_path: str = DEFAULT_OBJDUMP,
            stack_margin: float = DEFAULT_STACK_MARGIN):
        """
        Initialize the stack analyzer.

        Args:
            build_dir: Path to build directory containing object files
            threshold: Minimum stack usage threshold for reporting (bytes)
            show_warnings: Whether to display symbol resolution warnings
            objdump_path: Path to objdump executable
            stack_margin: Safety margin multiplier for thread stack recommendations
        """
        self.build_dir = Path(build_dir)
        self.threshold = threshold
        self.show_warnings = show_warnings
        self.objdump_path = objdump_path
        self.stack_margin = stack_margin
        self.logger = logging.getLogger(__name__)

        # Shared data container
        self._data = AnalysisData()

        # Component classes
        self._parser = ObjectFileParser(self.build_dir, objdump_path, self._data)
        self._analyzer = CallGraphAnalyzer(self._data, show_warnings)

        # Expose data attributes for backward compatibility
        self.frame_size = self._data.frame_size
        self.call_graph = self._data.call_graph
        self.total_cost = self._data.total_cost
        self.call_depth = self._data.call_depth
        self.visited = self._data.visited
        self.has_caller = self._data.has_caller
        self.unresolved = self._data.unresolved
        self.addresses = self._data.addresses
        self.global_name = self._data.global_name
        self.ambiguous = self._data.ambiguous
        self.has_function_pointer = self._data.has_function_pointer
        self.rtl_available = self._data.rtl_available
        self.code_size = self._data.code_size
        self.elf_code_size = self._data.elf_code_size
        self.elf_file = self._data.elf_file
        self.data_size = self._data.data_size
        self.bss_size = self._data.bss_size
        self.static_size = self._data.static_size

        # ELF-based static sizes (accurate after linking)
        self.elf_data_size = self._data.elf_data_size
        self.elf_bss_size = self._data.elf_bss_size
        self.func_static_vars = self._data.func_static_vars
        self.has_heap_alloc = self._data.has_heap_alloc
        self.git_info = self._data.git_info
        self.detected_threads = self._data.detected_threads
        self.symbol_sections = self._data.symbol_sections
        self.section_sizes = self._data.section_sizes
        self.memory_regions = self._data.memory_regions

    def find_object_files(self) -> List[str]:
        """Locate all relevant object files in the build directory."""
        if not self.build_dir.exists():
            raise FileNotFoundError(f"Build directory '{self.build_dir}' does not exist")
        return self._parser.find_object_files()

    def _find_rtl_files(self, obj_files: List[str]) -> List[str]:
        """
        Find RTL dump files corresponding to object files.

        RTL files are generated with -fdump-rtl-dfinish and have extensions like:
        - .c.270r.dfinish (GCC 5.x)
        - .c.271r.dfinish (GCC 6.x)
        - .c.272r.dfinish (GCC 7.x+)

        Args:
            obj_files: List of object file paths

        Returns:
            List of RTL dump file paths
        """
        rtl_files = []

        for obj_file in obj_files:
            # Get base name for RTL file search
            if obj_file.endswith('.o'):
                base_name = obj_file[:-2]  # Remove .o
            elif obj_file.endswith('.c.obj'):
                base_name = obj_file[:-6]  # Remove .c.obj
            else:
                continue

            # Search for RTL dump files with various extensions
            rtl_pattern = f"{base_name}.c.*r.dfinish"
            matching_files = glob.glob(rtl_pattern)

            if matching_files:
                # Use the first matching RTL file (should be only one)
                rtl_files.append(matching_files[0])

        return rtl_files

    def _detect_git_info(self) -> None:
        """
        Detect git repository information from current working directory.

        Extracts:
        - Git commit hash (full and short)
        - Current branch name
        - Repository status (clean/dirty)
        - Remote origin URL (if available)
        """
        try:
            # Check if we're in a git repository
            result = subprocess.run(['git', 'rev-parse', '--is-inside-work-tree'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)

            if result.returncode != 0:
                self.logger.debug("Not in a git repository")
                return

            # Get commit hash (full)
            result = subprocess.run(['git', 'rev-parse', 'HEAD'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['commit_hash'] = result.stdout.strip()
                self.git_info['commit_hash_short'] = result.stdout.strip()[:8]

            # Get current branch name
            result = subprocess.run(['git', 'rev-parse', '--abbrev-ref', 'HEAD'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['branch'] = result.stdout.strip()

            # Check if repository is clean
            result = subprocess.run(['git', 'status', '--porcelain'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['is_clean'] = len(result.stdout.strip()) == 0
                self.git_info['status'] = 'clean' if self.git_info['is_clean'] else 'dirty'

            # Get remote origin URL (if available)
            result = subprocess.run(['git', 'remote', 'get-url', 'origin'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['remote_url'] = result.stdout.strip()

            # Get commit message (first line)
            result = subprocess.run(['git', 'log', '-1', '--pretty=format:%s'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['commit_message'] = result.stdout.strip()

            # Get commit author and date
            result = subprocess.run(['git', 'log', '-1', '--pretty=format:%an'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['commit_author'] = result.stdout.strip()

            result = subprocess.run(['git', 'log', '-1', '--pretty=format:%ci'],
                                    capture_output=True, text=True, cwd=os.getcwd(),
                                    timeout=SUBPROCESS_TIMEOUT)
            if result.returncode == 0:
                self.git_info['commit_date'] = result.stdout.strip()

            if self.git_info:
                branch = self.git_info.get('branch', 'unknown')
                commit = self.git_info.get('commit_hash_short', 'unknown')
                self.logger.info(f"  ✓ Git repository detected: {branch}@{commit}")
                if not self.git_info.get('is_clean', True):
                    self.logger.info("  ⚠ Repository has uncommitted changes")

        except FileNotFoundError:
            self.logger.debug("Git not available")
        except Exception as e:
            if self.show_warnings:
                self.logger.warning(f"⚠️ Error detecting git info: {e}")

    def check_prerequisites(self) -> None:
        """
        Verify that all required tools and files are available for analysis.

        Checks for:
        - ARM objdump tool availability
        - Build directory existence
        - Presence of object files and stack usage files

        Returns:
            List of object files to process

        Raises:
            SystemExit: If prerequisites are not met
        """
        self.logger.info("🔍 Checking prerequisites...")

        # Detect git repository information
        self._detect_git_info()

        # Verify ARM toolchain availability
        try:
            subprocess.run([self.objdump_path, "--version"], capture_output=True, check=True,
                           timeout=SUBPROCESS_TIMEOUT)
            self.logger.info(f"  ✓ {self.objdump_path} found")
        except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
            error_msg = (f"{Colors.RED}❌ Error: {self.objdump_path} not found or timed out. "
                         f"Please install ARM GCC toolchain or specify correct path with --objdump.{Colors.END}")
            print(error_msg)
            sys.exit(1)

        # Verify build directory
        if not self.build_dir.exists():
            print(f"{Colors.RED}❌ Error: Build directory '{self.build_dir}' does not exist.{Colors.END}")
            print(f"{Colors.YELLOW}💡 Please run cmake and build the project first.{Colors.END}")
            sys.exit(1)

        # Locate object files
        obj_files = self.find_object_files()
        self.logger.info(f"  ✓ Found {len(obj_files)} object files")

        # Verify stack usage files exist
        su_files = []
        for obj_file in obj_files:
            # Handle both .o and .c.obj extensions
            if obj_file.endswith('.o'):
                su_file = obj_file[:-2] + '.su'
            elif obj_file.endswith('.c.obj'):
                su_file = obj_file[:-6] + '.c.su'
            else:
                continue

            if os.path.exists(su_file):
                su_files.append(su_file)

        if not su_files:
            print(f"{Colors.RED}❌ Error: No stack usage files (.su) found.{Colors.END}")
            print(f"{Colors.YELLOW}💡 Please compile with -fstack-usage flag to generate .su files.{Colors.END}")
            print(f"{Colors.YELLOW}💡 Add '-fstack-usage' to your CMakeLists.txt target_compile_options.{Colors.END}")
            sys.exit(1)

        self.logger.info(f"  ✓ Found {len(su_files)} stack usage files (from {len(obj_files)} object files)")

        # Check for RTL dump files for function pointer detection
        rtl_files = self._find_rtl_files(obj_files)
        if rtl_files:
            self.rtl_available = True
            self.logger.info(f"  ✓ Found {len(rtl_files)} RTL dump files for function pointer detection")
        else:
            self.logger.info("  ⚠ No RTL dump files found. Function pointer detection disabled.")
            self.logger.info("  💡 Compile with -fdump-rtl-dfinish for enhanced analysis.")

        return obj_files

    def parse_object_files(self, obj_files: List[str]) -> None:
        """
        Parse all object files to extract call graph and stack usage information.

        Args:
            obj_files: List of object file paths to process
        """
        self.logger.info(f"Parsing {len(obj_files)} object files...")

        for i, obj_file in enumerate(obj_files, 1):
            if i % 50 == 0 or i == len(obj_files):
                self.logger.debug(f"Progress: {i}/{len(obj_files)} files processed")

            self._parser.parse_disassembly(obj_file)
            self._parser.parse_su_file(obj_file)
            self._parse_code_sizes(obj_file)
            self._parser.parse_static_sizes(obj_file)

        if self._data.rtl_available:
            self._parse_rtl_files(obj_files)

        self.logger.info("Parsing complete")

    def _parse_disassembly(self, obj_file: str) -> None:
        """
        Parse objdump disassembly output to build function call graph.

        Extracts:
        - Function definitions and their addresses
        - Function call relationships via relocation entries
        - Symbol address mappings for resolution

        Args:
            obj_file: Path to object file to disassemble

        Raises:
            SystemExit: If disassembly fails
        """
        try:
            result = subprocess.run([self.objdump_path, "-dr", obj_file],
                                    capture_output=True, text=True, check=True,
                                    timeout=SUBPROCESS_TIMEOUT)

            current_function = None

            for line in result.stdout.splitlines():
                line = line.strip()

                # Match function definition: "00000000 <function_name>:"
                func_match = re.match(r'^([0-9a-fA-F]+) <(.*)>:', line)
                if func_match:
                    addr, name = func_match.groups()
                    current_function = f"{name}@{obj_file}"
                    self.call_graph[current_function] = set()

                    # Track ambiguous function names across object files
                    if name in self.global_name:
                        self.ambiguous.add(name)
                    self.global_name[name] = current_function

                    # Store address mapping for symbol resolution
                    addr = addr.lstrip('0') or '0'
                    self.addresses[f"{addr}@{obj_file}"] = current_function

                # Match function call: ": R_ARM_CALL target"
                call_match = re.search(r': R_[A-Za-z0-9_]+_CALL\s+(.+)', line)
                if call_match and current_function:
                    target = call_match.group(1)

                    # Detect heap allocation function calls
                    if target in HEAP_ALLOC_FUNCTIONS:
                        self.has_heap_alloc.add(current_function)

                    # Handle different call target formats
                    if target == ".text":
                        target = f"@{obj_file}"
                    elif target.startswith(".text+0x"):
                        offset = target[9:]  # Remove ".text+0x" prefix
                        target = f"{offset}@{obj_file}"

                    self.call_graph[current_function].add(target)

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
            print(f"{Colors.RED}❌ Error disassembling {obj_file}: {e}{Colors.END}")
            sys.exit(1)

    def _parse_su_file(self, obj_file: str) -> None:
        """
        Parse stack usage (.su) file to extract function frame sizes.

        The .su file format is: "path:line:column:function_name size qualifier"
        Frame sizes are adjusted by adding the ARM call overhead cost.

        Args:
            obj_file: Object file path (corresponding .su file will be located)
        """
        # Handle both .o and .c.obj extensions
        if obj_file.endswith('.o'):
            su_file = obj_file[:-2] + '.su'
        elif obj_file.endswith('.c.obj'):
            su_file = obj_file[:-6] + '.c.su'
        else:
            return

        try:
            with open(su_file, 'r', encoding='utf-8') as f:
                for line in f:
                    # Parse: "/path/file.c:137:20:function_name   size   qualifier"
                    match = re.search(r':([^:\t ]+)[\t ]+([0-9]+)[\t ]+', line)
                    if match:
                        func_name, size = match.groups()
                        # Add ARM function call overhead to frame size
                        self.frame_size[f"{func_name}@{obj_file}"] = int(size) + CALL_COST

        except FileNotFoundError:
            # Stack usage files may not exist for assembly files or system libraries
            pass

