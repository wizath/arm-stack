    def _parse_static_sizes(self, obj_file: str) -> None:
        """
        Parse object file to extract static allocation sizes using nm.

        Uses arm-none-eabi-nm to get .data and .bss symbol sizes from object files.
        Separates initialized (.data) from uninitialized (.bss) data.
        Also detects per-function static variables (named like func.varname).

        Args:
            obj_file: Object file path to analyze
        """
        nm_path = self.objdump_path.replace('objdump', 'nm')

        try:
            result = subprocess.run(
                [nm_path, '--print-size', obj_file],
                capture_output=True, text=True, check=True,
                timeout=SUBPROCESS_TIMEOUT
            )

            total_data = 0
            total_bss = 0
            for line in result.stdout.splitlines():
                # Format: "address size type name"
                # D/d = initialized data (.data), B/b = uninitialized data (.bss)
                parts = line.strip().split()
                if len(parts) >= 4:
                    size_hex, sym_type, sym_name = parts[1], parts[2], parts[3]
                    try:
                        size = int(size_hex, 16)
                    except ValueError:
                        continue

                    # Separate .data (D/d) from .bss (B/b)
                    if sym_type in ('D', 'd'):
                        total_data += size
                        var_type = 'data'
                    elif sym_type in ('B', 'b'):
                        total_bss += size
                        var_type = 'bss'
                    else:
                        continue

                    # Detect per-function static variables (pattern: func.varname or func.N)
                    if '.' in sym_name:
                        func_name = sym_name.split('.')[0]
                        var_name = sym_name.split('.', 1)[1]
                        if func_name not in self.func_static_vars:
                            self.func_static_vars[func_name] = []
                        self.func_static_vars[func_name].append((var_name, size, var_type))

            if total_data > 0:
                self.data_size[obj_file] = total_data
            if total_bss > 0:
                self.bss_size[obj_file] = total_bss
            if total_data + total_bss > 0:
                self.static_size[obj_file] = total_data + total_bss

        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            pass
        except FileNotFoundError:
            pass

    def detect_thread_entries(self) -> None:
        """
        Detect RTOS thread/task entry functions by scanning source files.

        Searches for common RTOS task creation patterns (FreeRTOS, Zephyr, etc.)
        and extracts the thread entry function names for stack analysis.
        """
        self.logger.info("🔍 Detecting RTOS thread entry points...")

        # Find all C source files in build directory and parent
        source_dirs = [self.build_dir]
        if self.build_dir.parent != self.build_dir:
            source_dirs.append(self.build_dir.parent)

        source_files = []
        for src_dir in source_dirs:
            source_files.extend(glob.glob(str(src_dir / "**/*.c"), recursive=True))
            source_files.extend(glob.glob(str(src_dir / "**/*.cpp"), recursive=True))

        detected_entries = {}  # entry_func -> (rtos, source_file)

        for source_file in source_files:
            try:
                with open(source_file, 'r', encoding='utf-8', errors='ignore') as f:
                    content = f.read()

                for rtos_name, patterns in RTOS_THREAD_PATTERNS.items():
                    for pattern, _, _ in patterns:
                        matches = re.findall(pattern, content)
                        for match in matches:
                            entry_func = match if isinstance(match, str) else match[0]
                            if entry_func and entry_func not in detected_entries:
                                detected_entries[entry_func] = (rtos_name, source_file)

            except (IOError, OSError):
                continue

        # Build ThreadInfo for each detected entry
        for entry_func, (rtos_name, source_file) in detected_entries.items():
            # Find the function's stack usage
            stack_usage = 0
            is_unbounded = False

            # Search for the function in our analyzed data
            for func_key, cost in self.total_cost.items():
                func_name = func_key.split('@')[0] if '@' in func_key else func_key
                if func_name == entry_func:
                    if cost == float('inf'):
                        is_unbounded = True
                        stack_usage = 0
                    else:
                        stack_usage = cost
                    break

            # Calculate recommended size (round up to nearest power of 2 or 256)
            if is_unbounded:
                recommended = 0
            else:
                with_margin = int(stack_usage * self.stack_margin)
                # Round up to nearest 256 bytes
                recommended = ((with_margin + 255) // 256) * 256
                # Minimum 512 bytes
                recommended = max(recommended, 512)

            thread_info = ThreadInfo(
                entry_func=entry_func,
                rtos=rtos_name,
                source_file=os.path.basename(source_file),
                stack_usage=stack_usage,
                recommended=recommended,
                is_unbounded=is_unbounded
            )
            self.detected_threads.append(thread_info)

        if self.detected_threads:
            self.logger.info(f"  ✓ Detected {len(self.detected_threads)} thread entry points")
        else:
            self.logger.info("  ✓ No RTOS thread patterns detected")

    def _parse_rtl_files(self, obj_files: List[str]) -> None:
        """
        Parse RTL dump files to detect function pointer calls.

        RTL dumps contain detailed information about function calls including
        indirect calls via function pointers, which make stack analysis unbounded.

        Args:
            obj_files: List of object file paths to find corresponding RTL files
        """
        self.logger.info("🔍 Analyzing RTL dumps for function pointer detection...")

        rtl_files = self._find_rtl_files(obj_files)
        functions_with_pointers = 0

        for rtl_file in rtl_files:
            try:
                self._parse_single_rtl_file(rtl_file)
            except Exception as e:
                if self.show_warnings:
                    self.logger.warning(f"⚠️ Error parsing RTL file {rtl_file}: {e}")

        functions_with_pointers = len(self.has_function_pointer)
        if functions_with_pointers > 0:
            self.logger.info(f"  ✓ Detected {functions_with_pointers} functions with function pointer calls")
        else:
            self.logger.info("  ✓ No function pointer calls detected")

    def _parse_single_rtl_file(self, rtl_file: str) -> None:
        """
        Parse a single RTL dump file to detect function pointer calls.

        RTL format analysis:
        - Function definitions: ";; Function function_name (symbol_name, funcdef_no=N)"
        - Direct calls: '(call ... "function_name" ...)'
        - Indirect calls: '(call ...' without quoted function name

        Args:
            rtl_file: Path to RTL dump file
        """
        # Extract object file path from RTL file for function mapping
        if '.c.' in rtl_file and rtl_file.endswith('.dfinish'):
            # Convert RTL filename back to object file
            base_name = rtl_file.split('.c.')[0]
            obj_file = base_name + '.o'
            if not os.path.exists(obj_file):
                obj_file = base_name + '.c.obj'
        else:
            return

        current_function = None

        # Regex patterns for RTL analysis
        function_pattern = re.compile(r'^;; Function (.*) \((\S+), funcdef_no=\d+.*\).*$')
        # Direct calls have symbol_ref with quoted function names
        direct_call_pattern = re.compile(r'.*\(call.*symbol_ref.*"([^"]+)".*\).*')
        # Indirect calls use registers instead of symbol_ref
        indirect_call_pattern = re.compile(r'.*\(call.*\(mem:SI \(reg.*\).*\).*')

        try:
            with open(rtl_file, 'r', encoding='utf-8', errors='ignore') as f:
                for line in f:
                    line = line.strip()

                    # Match function definition
                    func_match = function_pattern.match(line)
                    if func_match:
                        symbol_name = func_match.group(2)
                        current_function = f"{symbol_name}@{obj_file}"
                        continue

                    # Skip if no current function context
                    if not current_function:
                        continue

                    # Check for direct function calls (these are safe)
                    if direct_call_pattern.match(line):
                        continue

                    # Check for indirect function calls (function pointers)
                    if indirect_call_pattern.match(line):
                        self.has_function_pointer.add(current_function)
                        if self.show_warnings:
                            func_name = current_function.split('@')[0]
                            self.logger.debug(f"  Function pointer call detected in {func_name}")

        except FileNotFoundError:
            if self.show_warnings:
                self.logger.warning(f"⚠️ RTL file not found: {rtl_file}")
        except Exception as e:
            if self.show_warnings:
                self.logger.warning(f"⚠️ Error reading RTL file {rtl_file}: {e}")

