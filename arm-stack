    def _get_code_size(self, func_full_name: str) -> int:
        """Get code size for a function, preferring ELF (linked) over object file."""
        if self.elf_code_size:
            # Use ELF code size (by function name, not full path)
            base_name = func_full_name.split('@')[0] if '@' in func_full_name else func_full_name
            return self.elf_code_size.get(base_name, 0)
        else:
            # Fallback to object file code size
            return self.code_size.get(func_full_name, 0)

    def _prepare_function_data(self) -> tuple:
        """
        Prepare function data and file statistics for reporting.

        Returns:
            Tuple of (functions, file_stats, main_cost, max_iv_cost)
        """
        functions = []
        file_stats = defaultdict(lambda: {'count': 0, 'total_cost': 0, 'max_cost': 0, 'functions': []})
        max_iv_cost = 0
        main_cost = 0

        for func_full_name in sorted(self.total_cost.keys(),
                                     key=lambda x: self.total_cost[x], reverse=True):

            # Extract clean function name and source file using partition for efficiency
            display_name = func_full_name
            source_file = "unknown"

            if '@' in func_full_name:
                base_name, _, obj_file = func_full_name.partition('@')

                # Extract source file name from object file path
                if '/' in obj_file:
                    source_file = os.path.basename(obj_file).replace('.c.obj', '.c').replace('.o', '')
                else:
                    source_file = obj_file.replace('.c.obj', '.c').replace('.o', '')

                # Use clean name if not ambiguous
                if base_name not in self.ambiguous:
                    display_name = base_name

            # Determine function characteristics
            visit_status = self.visited.get(func_full_name, ' ')
            is_recursive = visit_status == 'R'
            is_root = func_full_name not in self.has_caller
            cost = self.total_cost[func_full_name]

            # Determine unbounded status and reason
            is_unbounded = cost == float('inf')
            unbounded_reason = None
            if is_unbounded:
                if visit_status == 'R':
                    unbounded_reason = 'recursion'
                elif visit_status == 'P':
                    unbounded_reason = 'function_pointer'
                elif visit_status == 'U':
                    unbounded_reason = 'unbounded_callee'
                else:
                    unbounded_reason = 'unknown'

            # Track special functions for summary (skip unbounded functions)
            if not is_unbounded:
                if "__vector_" in func_full_name:
                    max_iv_cost = max(max_iv_cost, cost)
                elif func_full_name.startswith("main@"):
                    main_cost = cost

            # Get static sizes for this file (separate .data and .bss)
            _, _, obj_file_path = func_full_name.partition('@')
            file_data_size = self.data_size.get(obj_file_path, 0)
            file_bss_size = self.bss_size.get(obj_file_path, 0)

            # Check if function has heap allocation calls
            has_heap = func_full_name in self.has_heap_alloc

            func_info = FunctionInfo(
                name=display_name,
                cost=cost,
                frame_size=self.frame_size.get(func_full_name, 0),
                height=self.call_depth.get(func_full_name, 0),
                is_recursive=is_recursive,
                is_root=is_root,
                is_unbounded=is_unbounded,
                unbounded_reason=unbounded_reason,
                code_size=self._get_code_size(func_full_name),
                data_size=file_data_size,
                bss_size=file_bss_size,
                has_heap_alloc=has_heap
            )

            functions.append(func_info)

            # Update file statistics
            if cost > 0:
                file_stats[source_file]['count'] += 1
                file_stats[source_file]['total_cost'] += cost
                file_stats[source_file]['max_cost'] = max(file_stats[source_file]['max_cost'], cost)
                file_stats[source_file]['functions'].append((display_name, cost, is_root))

        return functions, file_stats, main_cost, max_iv_cost

